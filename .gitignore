.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Generated artifacts land in data/ at runtime; keep the directory, not its contents.
data/*.csv
data/*.png
data/*.json
!data/.gitkeep
!data/evaluation_results.csv
!data/multiseed_results.csv
!data/multiseed_results_rate25.csv
!data/sensitivity.csv
!data/latency_per_request_aware_ceil.csv
!data/latency_per_request_aware_round.csv
!data/latency_per_request_baseline_ceil.csv
!data/latency_per_request_baseline_round.csv
!data/trace.csv
!data/trace_labeled.csv
!data/latency_summary.json
!data/multiseed_summary.json
!tests/golden/evaluation_results_round.csv

# SAM CLI build output (sam build); never committed.
.aws-sam/

# Live-run outputs (T13.1): never committed, directory kept.
data/live/*
!data/live/.gitkeep
.vercel
.env*
.DS_Store
dist/
node_modules/
